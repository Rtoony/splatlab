    {
      "id": "dn-splatter-geometry",
      "source_id": "dn-splatter",
      "enabled": false,
      "execution": "plan-only",
      "checkout_policy": "outside-splatlab-repository",
      "root_env_var": "SPLATLAB_RESEARCH_DN_SPLATTER_ROOT",
      "license_scope": "permissive-evaluation",
      "resources": {
        "gpu": true,
        "compute_gate_required": true,
        "minimum_vram_mb": 8000,
        "network_during_run": false
