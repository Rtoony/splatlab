{
  "schema": "dev.splatlab.research-adapters/v1",
  "adapters": [
    {
      "id": "mvsanywhere-depth-reg",
      "source_id": "mvsanywhere",
      "enabled": false,
      "execution": "plan-only",
      "checkout_policy": "outside-splatlab-repository",
      "root_env_var": "SPLATLAB_RESEARCH_MVSANYWHERE_ROOT",
      "license_scope": "restricted-research",
      "resources": {
        "gpu": true,
        "compute_gate_required": true,
        "minimum_vram_mb": 8000,
        "network_during_run": false
      },
      "required_paths": [
        "LICENSE",
        "src/mvsanywhere",
        "src/regsplatfacto"
      ],
      "accepts": [
        "nerfstudio-dataset",
        "posed-rgb-frames"
      ],
      "produces": [
        "depth-maps",
        "fused-mesh",
        "research-only-Gaussian-PLY",
        "benchmark-receipt"
      ],
      "manual_gates": [
        "weights-present-before-run",
        "license-acknowledgement",
        "coordinate-frame-check",
        "small-dataset-first",
        "operator-starts-compute-gated-run"
      ]
    },
    {
      "id": "acezero-pose-recovery",
      "source_id": "acezero",
